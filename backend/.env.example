PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
MOMO_SUBSCRIPTION_KEY=your-momo-key-here
ALLOWED_ORIGINS=*
# For production, set specific origins:
# ALLOWED_ORIGINS=https://alphatech.pages.dev,https://your-custom-domain.com

# Supabase Postgres connection string (required). Get it from:
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.<project-ref>.supabase.co:5432/postgres
# Set to "false" to disable SSL (not recommended). Leave unset for default SSL.
# DATABASE_SSL=false
